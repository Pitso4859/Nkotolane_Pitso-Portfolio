# EmailJS browser configuration used by the portfolio booking flow.
# Copy this file to .env.local and populate the values locally.
# Never put server-side secrets or passwords in VITE_ variables.

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_BOOKING_TEMPLATE=
VITE_EMAILJS_ADMIN_TEMPLATE=
